---
import type { HTMLAttributes } from 'astro/types';

type AnchorProps = HTMLAttributes<'a'> & { type?: never, variant?: 'primary' | 'secondary' };
type ButtonProps = HTMLAttributes<'button'> & { href?: never, variant?: 'primary' | 'secondary' };

type Props = ButtonProps | AnchorProps;

const { href, class: className, variant = 'primary', ...rest } = Astro.props;

const baseClasses = 'px-6 pt-3 pb-3.5 inline-flex items-center justify-center gap-x-2 font-mono text-sm font-medium rounded-md transition-colors duration-200';

const variantClasses = {
  primary: 'text-zinc-950 bg-custom-pink hover:bg-custom-pink/90',
  secondary: 'text-main border border-main/20 hover:border-custom-pink hover:bg-custom-pink/10',
};

const buttonClasses = `${baseClasses} ${variantClasses[variant]}`;
---
{
    href ? (
        <a href={`${href}`} class:list={[buttonClasses, className]} {...rest}>
            <slot />
        </a>
    ) : (
        <button class:list={[buttonClasses, className]} {...rest}>
            <slot />
        </button>
    )
}
