---
import siteConfig from "../data/site-config";
import iconMap from "../data/icon-map";

const socialLinks = siteConfig.socialLinks || [];
const navLinks = siteConfig.footerNavLinks || [];
---

<footer class="mt-auto w-full max-w-[85rem] border-t border-main/10 py-10 mx-auto">
    <!-- Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 items-center gap-5">
        <div class="inline-flex items-center">
            <a
                class="font-mono font-medium tracking-widest uppercase border-b-2 border-transparent sm:text-lg hover:border-custom-pink"
                href={`${import.meta.env.BASE_URL}/`}
                aria-label="Zur Startseite"
            >
                {siteConfig.title}
            </a>

            <div class="border-s ps-5 ms-5">
                <p class="text-sm text-neutral-400">&copy; {new Date().getFullYear()}&nbsp;</p>
              </div>
        </div>
        <!-- End Col -->

        {
            navLinks.length > 0 && (
                <ul class="text-center">
                    {navLinks.map((link) => (
                        <li class="inline-block relative pe-8 last:pe-0 last-of-type:before:hidden before:absolute before:top-1/2 before:end-3 before:-translate-y-1/2 before:content-['/'] before:text-gray-300 dark:before:text-neutral-600">
                            <a
                                class="inline-flex gap-x-2 font-mono text-sm text-main/65 decoration-custom-pink underline-offset-4 hover:text-main hover:underline"
                                href={`${import.meta.env.BASE_URL}${link.href}`}
                            >
                                {link.text}
                            </a>
                        </li>
                    ))}
                </ul>
            )
        }

        <!-- Social Brands -->
        {
            socialLinks.length > 0 && (
                <div class="md:text-end space-x-2">
                    {socialLinks.map((link) => (
                        <a
                            class="size-8 inline-flex justify-center items-center gap-x-2 text-sm font-semibold rounded-md border border-transparent text-main/65 transition-colors hover:border-custom-pink/20 hover:bg-custom-pink/10 hover:text-main disabled:opacity-50 disabled:pointer-events-none"
                            href={`${import.meta.env.BASE_URL}${link.href}`}
                            aria-label={link.text}
                        >
                            {link.icon && <Fragment set:html={ iconMap[link.icon] } />}
                        </a>
                    ))}
                </div>
            )
        }
        <!-- End Social Brands -->
    </div>
    <!-- End Grid -->
</footer>
