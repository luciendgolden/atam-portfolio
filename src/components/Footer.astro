---
import siteConfig from "../data/site-config";
import iconMap from "../data/icon-map";

const socialLinks = siteConfig.socialLinks || [];
const navLinks = siteConfig.footerNavLinks || [];
---

<footer class="site-footer">
    <div class="footer-identity">
        <a href={`${import.meta.env.BASE_URL}/`}>{siteConfig.title}<span aria-hidden="true">_</span></a>
        <span>© {new Date().getFullYear()}</span>
    </div>
    <nav aria-label="Footer navigation">
        {navLinks.map((link) => <a href={`${import.meta.env.BASE_URL}${link.href}`}>{link.text}</a>)}
    </nav>
    <div class="footer-socials">
        {socialLinks.map((link) => (
            <a href={link.href.startsWith("/") ? `${import.meta.env.BASE_URL}${link.href}` : link.href} aria-label={link.text}>
                {link.icon && <Fragment set:html={iconMap[link.icon]} />}
            </a>
        ))}
    </div>
</footer>
