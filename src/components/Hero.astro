---
import { marked } from "marked";
import Button from "./Button.astro";
import StateSpace from "./StateSpace.astro";
import ArrowRight from "../icons/ArrowRight.astro";
import siteConfig from "../data/site-config";

const hero = siteConfig.hero;
---

{hero && (
    <section class="hero" aria-labelledby="hero-title">
        <div class="hero-layout">
            <div>
                <p class="eyebrow">{siteConfig.title} / Personal portfolio</p>
                {hero.title && <h1 id="hero-title">{hero.title.split("\n").map((line) => <span>{line}</span>)}</h1>}
                {hero.text && <div class="hero-copy" set:html={marked.parse(hero.text)} />}
                <div class="hero-actions">
                    <Button href={`${import.meta.env.BASE_URL}/projects`}>
                        Explore projects <ArrowRight class="w-4 h-4 fill-current" />
                    </Button>
                    {hero.actions?.map((action) => (
                        <a class="text-link" href={`${import.meta.env.BASE_URL}${action.href}`}>
                            {action.text} <span aria-hidden="true">↗</span>
                        </a>
                    ))}
                </div>
            </div>
            <StateSpace />
        </div>
        <div class="hero-disciplines" aria-label="Areas of interest">
            <span><span class="discipline-index" aria-hidden="true">01 /</span> Computer science</span>
            <span><span class="discipline-index" aria-hidden="true">02 /</span> Machine learning</span>
            <span><span class="discipline-index" aria-hidden="true">03 /</span> Robotics</span>
        </div>
    </section>
)}
