---
import { type CollectionEntry } from "astro:content";
import ArrowRight from "../icons/ArrowRight.astro";
import FormattedDate from "./FormattedDate.astro";

type Props = {
    post: CollectionEntry<"blog">;
    class?: string;
    headingLevel?: "h2" | "h3";
};

const { post, class: className, headingLevel = "h3" } = Astro.props;
const { title, publishDate, updatedDate, excerpt, tags, seo } = post.data;
const TitleTag = headingLevel;
---

<article class:list={["post-preview", className]}>
    <a class="post-link group" href={`${import.meta.env.BASE_URL}/blog/${post.slug}/`}>
        {seo?.image && (
            <div class="post-image">
                <img
                    src={`${import.meta.env.BASE_URL}${seo.image.src}`}
                    alt={seo.image.alt || `Image for ${title}`}
                    loading="lazy"
                    decoding="async"
                    width="360"
                    height="280"
                />
            </div>
        )}
        <div class="post-content">
            <div class="post-meta">
                <FormattedDate date={publishDate} />
                {updatedDate && <span>Updated <FormattedDate date={updatedDate} /></span>}
            </div>
            <TitleTag>{title}</TitleTag>
            {excerpt && <p class="post-excerpt">{excerpt}</p>}
            <div class="post-bottom">
                <div class="post-tags">{tags.map((tag) => <span>{tag}</span>)}</div>
                <span class="post-read">Read article <ArrowRight class="w-4 h-4 fill-current" /></span>
            </div>
        </div>
    </a>
</article>
