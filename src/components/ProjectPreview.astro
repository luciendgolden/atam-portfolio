---
import { type CollectionEntry } from "astro:content";
import ArrowRight from "../icons/ArrowRight.astro";

type Props = {
    project: CollectionEntry<"projects">;
    class?: string;
    headingLevel?: "h2" | "h3";
};

const { project, class: className, headingLevel = "h3" } = Astro.props;
const { title, description, seo, publishDate } = project.data;
const TitleTag = headingLevel;
---

<a class:list={["project-card group", className]} href={`${import.meta.env.BASE_URL}/projects/${project.slug}/`}>
    {seo?.image && (
        <div class="project-image">
            <img
                src={`${import.meta.env.BASE_URL}/${seo.image.src.replace(/^\//, "")}`}
                alt={seo.image.alt || `Image for ${title}`}
                loading="lazy"
                decoding="async"
                width="960"
                height="540"
            />
            <span class="project-image-label eyebrow">Project / {publishDate.getFullYear()}</span>
        </div>
    )}
    <div class="project-content">
        <div class="project-title">
            <TitleTag>{title}</TitleTag>
            <ArrowRight class="project-arrow w-5 h-5 fill-current" />
        </div>
        {description && <p>{description}</p>}
    </div>
</a>
