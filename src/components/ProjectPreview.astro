---
import { type CollectionEntry } from "astro:content";
import ArrowRight from "../icons/ArrowRight.astro";

type Props = {
    project: CollectionEntry<"projects">;
    class?: string;
    headingLevel?: "h2" | "h3";
};

const { project, class: className, headingLevel = "h3" } = Astro.props;
const { title, description, seo } = project.data;
const TitleTag = headingLevel;
---

<a
    class:list={[
        "group flex h-full flex-col overflow-hidden rounded-xl bg-zinc-900",
        className,
    ]}
    href={`${import.meta.env.BASE_URL}/projects/${project.slug}/`}
>
    {
        seo?.image && (
            <div class="aspect-video w-full shrink-0 overflow-hidden bg-[#1b191e]">
                <img
                    src={
                        seo.image.src.startsWith("/")
                            ? import.meta.env.BASE_URL + seo.image.src
                            : import.meta.env.BASE_URL + `/${seo.image.src}`
                    }
                    alt={seo.image.alt || `Abbildung zu ${title}`}
                    class="size-full object-cover object-top group-hover:scale-105 transition-transform duration-500 ease-in-out"
                />
            </div>
        )
    }
    <div class="flex flex-1 flex-col p-5 sm:p-6">
        <TitleTag
            class="text-xl sm:text-2xl font-semibold leading-snug text-white underline decoration-dashed underline-offset-4 decoration-transparent transition-colors duration-300 ease-in-out group-hover:decoration-custom-pink"
        >
            {title}
        </TitleTag>
        {
            description && (
                <div class="mt-3 text-sm leading-relaxed text-white/70">{description}</div>
            )
        }
    </div>
</a>
