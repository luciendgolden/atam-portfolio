---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

const { pathname } = Astro.url;
const linkPath = href?.replace(/\/$/, '');
const pagePath = pathname.replace(/\/$/, '');
const homePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const isActive = linkPath === pagePath || (linkPath !== homePath && pagePath.startsWith(`${linkPath}/`));
---

<a class:list={[className, { 'is-active': isActive }]} href={href} aria-current={isActive ? 'page' : undefined} {...props}>
    <slot />
</a>
